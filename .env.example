# ── Front Office AI · environment ───────────────────────────────
# Copy to .env and fill in. NEVER commit .env to git.

# App
PORT=3000
# Set to "production" on any real deploy — the app refuses to boot in
# production without a real JWT_SECRET (see below), rather than silently
# falling back to an insecure default. Production also refuses to boot
# without VAPI_SERVER_SECRET (same fail-closed idea). META_APP_SECRET,
# GOOGLE_ADS_WEBHOOK_KEY, and RESEND_INBOUND_SECRET are NOT required to boot.
NODE_ENV=production
# Generate a real random value (e.g. `openssl rand -hex 32`) — never leave
# this as the placeholder text below on a real deploy.
JWT_SECRET=generate-a-long-random-string
CLINIC_NAME=Innslake Dental
RECEPTIONIST_NUMBER=(804) 555-0100
OWNER_EMAIL=owner@clinic.com
# Change this before going live, then use the in-app "change password" flow
# for any future rotation — don't just edit this var and re-seed, which
# wipes the live database.
OWNER_PASSWORD=changeme123

# Which client this process is — folder under instances/<id>/
# (shine-dental, the-burg, rprg, sailz-hq). Do not rename instance folders
# or clinic-profile.json to match a branding change; CLINIC_NAME is display.
INSTANCE=shine-dental
# Optional override for the JSON store path (single-tenant only).
# DB_PATH=

# Claude (agent reasoning: note structuring, code suggestions)
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Vapi (AI receptionist + outbound calls) — vapi.ai
# Buy a number in Vapi (provisioned via Twilio), create two assistants:
# one inbound (receptionist), one outbound (appointment setter).
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_OUTBOUND_ASSISTANT_ID=
VAPI_INBOUND_ASSISTANT_ID=
# In Vapi assistant settings, set Server URL to: https://YOUR-DOMAIN/webhooks/vapi

# Brain learning -> knowledge sync (server/vapiSync.js). Default is dry-run:
# approved knowledge is composed and logged, never pushed to the live
# inbound assistant. Set to "0" only once you've reviewed a few dry-run log
# lines and are ready for real pushes to reach the live phone assistant.
VAPI_SYNC_DRY_RUN=1

# Meta Lead Ads — developers.facebook.com (app + leadgen webhook)
# Webhook URL: https://YOUR-DOMAIN/webhooks/meta
META_LEAD_ADS_TOKEN=
META_VERIFY_TOKEN=any-string-you-choose
# Your app's secret (App Dashboard → Settings → Basic) — enables
# X-Hub-Signature-256 verification on incoming lead payloads. Without this,
# the webhook accepts unsigned requests from anyone who finds the URL.
# Optional at boot (warns, does not refuse to start).
META_APP_SECRET=

# Google Ads lead form webhook
# Paste this key in the lead form's webhook config; URL: https://YOUR-DOMAIN/webhooks/google
# Optional at boot (warns, does not refuse to start).
GOOGLE_ADS_WEBHOOK_KEY=

# Google Calendar (service account) — console.cloud.google.com → IAM & Admin
# → Service Accounts → Create → Keys → Add Key (JSON). Then open the clinic's
# Google Calendar → Settings → "Share with specific people" → paste the
# service account's ...@...iam.gserviceaccount.com email, permission
# "Make changes to events".
# Value can be a path to the downloaded key file, or the raw JSON pasted as
# a single line (useful on hosts without persistent file storage, e.g. Railway).
GOOGLE_CALENDAR_CREDENTIALS=
# The calendar to check/book against — from that calendar's Settings →
# "Integrate calendar" → Calendar ID.
GOOGLE_CALENDAR_ID=
# IANA timezone the clinic operates in — required for correct slot math and
# Google Calendar event timezone. Falls back to settings.receptionist.timezone
# in clinic-profile.json if unset.
CLINIC_TIMEZONE=America/New_York
# Shared secret Vapi sends back as the x-vapi-secret header on every
# Server URL request; set the same value in the Vapi tool/assistant config.
# Required to boot when NODE_ENV=production (fail-closed, same idea as JWT_SECRET).
VAPI_SERVER_SECRET=

# Claim.MD (claims clearinghouse) — claim.md
CLAIMMD_API_KEY=

# Twilio (SMS confirmations/reminders) — optional but recommended
# TWILIO_ACCOUNT_SID is always the AC... Account SID (used in the request URL).
# TWILIO_SID/TWILIO_AUTH are the Basic Auth credential pair — either the
# Account SID + Auth Token, or an API Key SID (SK...) + API Key Secret.
TWILIO_ACCOUNT_SID=
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
# Twilio Lookup (server/research.js checkPhoneType) — account Auth Token,
# not a scoped API key. Distinct from TWILIO_AUTH above.
# TWILIO_AUTH_TOKEN=
# Buying numbers on the platform service (server/tenantNumberProvision.js).
# TWILIO_ACCOUNT_AUTH_TOKEN=

# Resend (booking confirmation/reminder email) — optional
# RESEND_FROM must be an address on a domain verified in your Resend
# account (Settings → Domains). A domain you don't control the DNS for
# (e.g. an auto-assigned *.up.railway.app address) can never verify.
RESEND_API_KEY=
RESEND_FROM=
# Optional inbound webhook secret (x-resend-secret). Not required to boot;
# when unset, /webhooks/resend does not enforce the header.
# RESEND_INBOUND_SECRET=

# Onboarding wizard (server/onboarding.js) — where Sailz itself gets
# notified when a client finishes the wizard and when a draft is activated.
# No-ops with a logged warning if unset or if RESEND_API_KEY isn't configured.
SAILZ_NOTIFY_EMAIL=

# Voice-memo/recording transcription for the onboarding wizard and the
# client-side "Teach Your Brain" surface (server/onboarding.js) — optional.
# Set at most one; Deepgram is tried first if both are set. Without either,
# audio uploads are still saved and the wizard still works — they're just
# queued for the Sailz team to review manually instead of auto-transcribed.
# deepgram.com → API key (Pay As You Go or free trial credit both work)
DEEPGRAM_API_KEY=
# assemblyai.com → API key
ASSEMBLYAI_API_KEY=

# Password reset / magic-link login (server/server.js auth routes) — sent
# via the same Resend config above. No-ops gracefully without RESEND_API_KEY
# (the request still returns {ok:true} so the endpoint is not a user-exists
# oracle). Links expire (reset 30 min, magic 15 min) and are single-use.

# ── Feature flags (off unless set to 1 / true) ──────────────────
# HQ provisioning console (admin.html, /api/hq/*, onboarding review).
# Set SAILZ_ADMIN=1 only on Sailz's own internal instance (sailz-hq).
# Client deploys (Shine, Burg, RPRG) must leave this unset.
SAILZ_ADMIN=0
# HQ-as-a-client: Sailz's own sales/outbound/research/site-chat path.
# Requires SAILZ_ADMIN=1 as well; never silently implied by the admin flag.
HQ_LIVE=0
# Public marketing site (site/), host-routed. Requires SAILZ_ADMIN=1.
SITE_ENABLED=0
# Comma-separated Host values that should serve the marketing site
# instead of the dashboard (server/siteHost.js). Default: sailz.org,www.sailz.org
SITE_HOSTS=sailz.org,www.sailz.org
# Haiku qualification chat on the marketing site (POST /api/site/chat).
# Requires HQ_LIVE=1 (which itself requires SAILZ_ADMIN=1).
SITE_CHAT=0
# Compose Vapi assistant config from this repo on assistant-request.
# Off by default; flip per service after the operator steps in vapiAssistant.js.
VAPI_ASSISTANT_REQUEST=0
# Owner-placed immediate test call through the production dialer path.
# Off by default; currently used on rprg.
TEST_CALL_ENABLED=0
# Public-business-info research on a lead's company (server/researcher.js).
# Off by default; currently used on rprg.
ENRICHMENT_ENABLED=0
# HQ ICP-based lead sourcing routes (server/research.js). Off by default;
# only meaningful with SAILZ_ADMIN=1.
RESEARCH_ENABLED=0
# Demo UI mode (dashboard demoMode flag). Leave unset in production.
# DEMO_MODE=0

# Shared secret for GET /api/heartbeat (header x-sailz-hq-key).
# No key configured means nobody can poll this instance (safe default).
HEARTBEAT_KEY=

# Multi-tenant platform mode — NEVER set on a legacy dedicated client
# (Shine / Burg / RPRG / HQ). Only the separate platform service.
MULTI_TENANT=0
# Postgres URL required when MULTI_TENANT=1 (server/tenantStore.js).
# DATABASE_URL=
# Set PGSSL=0 for local Postgres with no TLS.
# PGSSL=0
# Shared secret for /api/platform/* (header x-sailz-platform-key).
# On HQ, this plus PLATFORM_BASE_URL proxy admin.html to the platform service.
PLATFORM_KEY=
# PLATFORM_BASE_URL=https://platform.example.com
# PLATFORM_BASE_DOMAIN=sailz.org
# Buy Twilio numbers for approved tenants (off by default; spends money).
# NUMBER_PROVISIONING=0

# Research / enrichment providers (optional; modules degrade if unset)
# PERPLEXITY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# Restaurant kitchen ticket (server/notify.js) — optional
# KITCHEN_SMS=
# KITCHEN_EMAIL=
